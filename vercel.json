{
  "rewrites": [
    {
      "source": "/api/os-tracking/:token",
      "destination": "/api/os-tracking?token=:token"
    },
    {
      "source": "/api/ai/:action",
      "destination": "/api/ai?action=:action"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
