{
  "rewrites": [
    {
      "source": "/api/os-tracking/:token",
      "destination": "/api/os-tracking?token=:token"
    },
    {
      "source": "/api/auth/change-super-password",
      "destination": "/api/auth/change-password?isSuper=true"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

